# --- Storage ---
# Local Docker uses OpenSearch. Vercel should set this to postgres.
STORE_BACKEND=opensearch

# --- OpenSearch (local) ---
# The existing local container runs with DISABLE_SECURITY_PLUGIN=true,
# so plain HTTP with no credentials.
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
INDEX_PREFIX=sds

# --- Supabase PostgreSQL (Vercel) ---
# Use the transaction pooler URL (port 6543) and append sslmode=require.
DATABASE_URL=

# --- Authentication ---
# Keep true locally. Set false in Vercel.
AUTH_DISABLED=true
LOCAL_USER_ID=local
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Configure at least one owner value in Vercel.
OWNER_USER_ID=
OWNER_EMAIL=
CORS_ORIGINS=*

# Frontend build-time settings. Leave empty for local no-login mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
# Leave empty to disable the AI features; the UI stays usable without it.
GEMINI_API_KEY=
# Note: the gemini-2.x models are no longer available to newly created API keys.
GEMINI_MODEL=gemini-3.5-flash

# --- Market data fallback ---
# Optional. Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# --- Ports on the host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
